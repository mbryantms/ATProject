{
  "name": "atproject",
  "version": "1.0.0",
  "description": "A personal place for all my thoughts",
  "scripts": {
    "build": "npm-run-all --parallel build:css build:js:*",
    "build:css": "postcss static/css/src/*.css --dir static/css/dist/",
    "build:js": "npm-run-all --parallel build:js:*",
    "build:js:standalone": "esbuild static/js/standalone-entry.js --bundle --minify --target=es2017 --outfile=static/js/dist/standalone.js --legal-comments=none",
    "build:js:main": "esbuild static/js/main-entry.js --bundle --minify --target=es2017 --outfile=static/js/dist/main.js --legal-comments=none",
    "build:js:citations": "esbuild static/js/citation-tooltip.js --bundle --minify --target=es2017 --outfile=static/js/dist/citation-tooltip.js --legal-comments=none",
    "build:js:admin-post-editor": "esbuild static/js/admin-post-editor-entry.js --bundle --minify --target=es2017 --outfile=static/js/dist/admin-post-editor.js --legal-comments=none",
    "dev": "npm-run-all --parallel watch:css watch:js:*",
    "watch:css": "postcss static/css/src/*.css --dir static/css/dist/ --watch",
    "watch:js:standalone": "npm run build:js:standalone -- --watch",
    "watch:js:main": "npm run build:js:main -- --watch",
    "watch:js:citations": "npm run build:js:citations -- --watch",
    "watch:js:admin-post-editor": "npm run build:js:admin-post-editor -- --watch",
    "format": "prettier --write \"**/*.{css,html,js,json}\"",
    "format:check": "prettier --check \"**/*.{css,html,js,json}\"",
    "lint:js": "eslint \"**/*.js\" --fix"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "autoprefixer": "^10.5.0",
    "baseline-browser-mapping": "^2.10.37",
    "cssnano": "^8.0.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.15",
    "postcss-cli": "^11.0.1",
    "postcss-custom-properties": "^15.0.1",
    "postcss-import": "^16.1.1",
    "postcss-mixins": "^12.1.2",
    "postcss-nested": "^7.0.2",
    "postcss-sorting": "^10.0.0",
    "prettier": "^3.8.4"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.1",
    "@floating-ui/dom": "^1.7.6",
    "@lezer/highlight": "^1.2.3"
  }
}
